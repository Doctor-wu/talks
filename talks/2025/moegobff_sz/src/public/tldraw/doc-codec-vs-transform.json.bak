    "shape:codec": {
      "x": 100,
      "y": 150,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:codec",
      "typeName": "shape",
      "parentId": "page:page",
      "index": "a1",
      "type": "geo",
      "props": {
        "w": 350,
        "h": 300,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "color": "green",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "draw",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "attrs": { "dir": "auto" },
              "content": [{ "type": "text", "text": "Codec ✅\n\n✅ 双向转换\n   encode + decode\n\n✅ 响应格式化支持\n   .encode() 方法\n\n✅ OpenAPI 导出外部类型\n   前端看到的是 string\n\n✅ 前端使用友好\n   传入原始类型即可" }]
            }
          ]
        }
      }
    },
    "shape:transform": {
      "x": 550,
      "y": 150,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "id": "shape:transform",
      "typeName": "shape",
      "parentId": "page:page",
      "index": "a2",
      "type": "geo",
      "props": {
        "w": 350,
        "h": 300,
        "geo": "rectangle",
        "dash": "draw",
        "growY": 0,
        "url": "",
        "scale": 1,
        "color": "red",
        "labelColor": "black",
        "fill": "semi",
        "size": "m",
        "font": "draw",
        "align": "start",
        "verticalAlign": "start",
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "attrs": { "dir": "auto" },
              "content": [{ "type": "text", "text": "Transform ❌\n\n❌ 单向转换\n   仅 decode\n\n❌ 无响应格式化\n   无 .encode() 方法\n\n❌ OpenAPI 导出内部类型\n   前端看到的是 bigint\n\n❌ 前端使用困难\n   需传入 transform 后的类型" }]
            }
          ]
        }
      }
    },
